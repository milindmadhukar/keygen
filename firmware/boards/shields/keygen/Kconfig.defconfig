if SHIELD_KEYGEN_LEFT

config ZMK_KEYBOARD_NAME
    default "Keygen"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# report the right half's battery to the host as well
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif

if SHIELD_KEYGEN_LEFT || SHIELD_KEYGEN_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

# the SSD1306 is monochrome: without these LVGL draws in 16-bit colour and the mono flush faults
if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
