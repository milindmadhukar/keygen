/*
 * Per-key SK6812MINI-E chain: 33 per half, data on P0.06 (pad 1), driven as one strip. The chain
 * runs from the battery through the board's LED power switch (Q2/Q3), which P0.08 (pad 2) turns on.
 *
 * OLED: a 0.96 in. 128x64 SSD1306 per half on I2C, SDA P0.17 (pad 5), SCL P0.20 (pad 6), powered
 * from the nice!nano's switched 3.3 V (VCC, pad 16), which P0.13 turns on.
 */

#include <dt-bindings/led/led.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };

    /* the module has its own pull-ups; the internal ones keep the bus up on a module without them */
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    /* The SSD1306 takes no repeated start inside a write, so TWIM merges the control byte and the
     * data into one transfer. The default 16-byte buffer fails every frame write with -ENOSPC;
     * this holds the control byte plus a full 128 x 64 / 8 = 1024-byte frame. */
    zephyr,concat-buf-size = <1025>;

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    /* The module is mounted upside down (header along its bottom edge). With segment-remap and
     * com-invdir it would draw for a module the usual way up. */
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* SK6812MINI-E */
        chain-length = <33>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
        zephyr,display = &oled;
    };
};

/* ext-power drives only the LED power switch on P0.08, so the LEDs can go off on battery */
&{/EXT_POWER} {
    control-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
};

/* P0.13 keeps the nice!nano's 3.3 V output, and so the OLED, powered; ZMK blanks the OLED when idle */
&gpio0 {
    vcc_on {
        gpio-hog;
        gpios = <13 GPIO_ACTIVE_HIGH>;
        output-high;
    };
};
